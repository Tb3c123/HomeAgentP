# Copy to deploy/.env on NAS; never commit deploy/.env.
# Generate strong UNIQUE values locally; never copy example placeholders into live deployment.
HOMEAGENTP_SECRET_KEY=REPLACE_WITH_RANDOM_64_PLUS_CHARACTER_SECRET
HOMEAGENTP_ADMIN_USERNAME=admin
HOMEAGENTP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_ADMIN_PASSWORD
# Localhost binding requires SSH tunnel or an approved authenticated proxy.
HOMEAGENTP_BIND_IP=127.0.0.1
HOMEAGENTP_PORT=8310
# False for plain HTTP localhost; set true ONLY when accessed via verified HTTPS reverse proxy.
HOMEAGENTP_COOKIE_SECURE=false
