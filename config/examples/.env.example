# HomeAgentP B+ — Example Environment Configuration (Phase 01 Foundation + Phase 02 NAS Guardian)
# IMPORTANT: Copy to .env for local development only. NEVER commit real secrets to Git.

# Application environment: development | testing | staging
HOMEAGENTP_ENV=development

# Candidate web port (bound to 127.0.0.1 in local dev compose)
HOMEAGENTP_PORT=8310
HOMEAGENTP_CORE_HOST=127.0.0.1
HOMEAGENTP_CORE_PORT=8311

# SQLite Database path (local isolated path for dev)
HOMEAGENTP_DB_PATH=./data/homeagentp.db

# Security & Session configuration
# Replace these placeholders with newly generated random values in local .env:
# e.g., python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HOMEAGENTP_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_32_BYTE_SECRET_KEY
HOMEAGENTP_ADMIN_USERNAME=admin
HOMEAGENTP_ADMIN_PASSWORD=CHANGE_ME_STRONG_LOCAL_DEV_PASSWORD
HOMEAGENTP_SESSION_TTL_SECONDS=28800
HOMEAGENTP_COOKIE_SECURE=false

# Read-only allowlisted directories for Script Registry and Reports
HOMEAGENTP_SCRIPTS_DIR=./config/examples/scripts
HOMEAGENTP_REPORTS_DIR=./config/examples/reports

# Seed minimal sample metadata on startup (true for local dev, false for staging)
HOMEAGENTP_SEED_EXAMPLES=true

# Phase 02 — NAS Guardian (Read-Only Telemetry & Mount Integrity)
# Set HOMEAGENTP_NAS_ADAPTER_ENABLED=true and choose telemetry_mode:
# - host_snapshot (recommended for containerized Debian 12 / CasaOS): reads nas_host_snapshot.json
#   written atomically into HOMEAGENTP_REPORTS_DIR by a least-privilege host systemd timer.
# - direct_host_fs: inspects explicit read-only host mounts (/host/proc, /host/root); rejects
#   container-local /proc, /, or overlayfs so container namespace is never mistaken for NAS host.
HOMEAGENTP_NAS_ADAPTER_ENABLED=false
HOMEAGENTP_NAS_TELEMETRY_MODE=disabled
HOMEAGENTP_NAS_HOST_SNAPSHOT_REL_PATH=nas_host_snapshot.json
HOMEAGENTP_NAS_SNAPSHOT_MAX_AGE_SECONDS=180
HOMEAGENTP_NAS_PROC_ROOT=/host/proc
HOMEAGENTP_NAS_ROOT_MOUNT_PATH=/host/root
HOMEAGENTP_NAS_REQUIRED_MOUNTS=["/mnt/disk1","/mnt/disk2"]
HOMEAGENTP_NAS_EXPECTED_SERVICES=["jellyfin","sonarr","radarr","bazarr","prowlarr","seerr","qbittorrent","adguard","portainer"]
# Optional relative path inside HOMEAGENTP_REPORTS_DIR for read-only container status snapshot JSON
# (Never mount /var/run/docker.sock into HomeAgentP)
HOMEAGENTP_NAS_CONTAINER_SNAPSHOT_REL_PATH=
# Background automatic collection scheduler (P02-F02)
HOMEAGENTP_NAS_SCHEDULER_ENABLED=false
HOMEAGENTP_NAS_COLLECTION_INTERVAL_SECONDS=60
HOMEAGENTP_NAS_COLLECTION_TIMEOUT_SECONDS=10.0
HOMEAGENTP_NAS_MIN_PERSIST_INTERVAL_SECONDS=15
HOMEAGENTP_NAS_HISTORY_RETENTION_LIMIT=120

# NAS Guardian Alert Thresholds (Percentages)
HOMEAGENTP_NAS_CPU_WARN_PERCENT=80.0
HOMEAGENTP_NAS_CPU_CRITICAL_PERCENT=95.0
HOMEAGENTP_NAS_RAM_WARN_PERCENT=85.0
HOMEAGENTP_NAS_RAM_CRITICAL_PERCENT=95.0
HOMEAGENTP_NAS_DISK_WARN_PERCENT=85.0
HOMEAGENTP_NAS_DISK_CRITICAL_PERCENT=95.0
HOMEAGENTP_NAS_CONTAINER_MEM_WARN_PERCENT=85.0
HOMEAGENTP_NAS_CONTAINER_MEM_CRITICAL_PERCENT=95.0

# Phase 03-05 integrations (Placeholders ONLY — not active in Phase 02)
HOMEAGENTP_JELLYFIN_URL=
HOMEAGENTP_SONARR_URL=
HOMEAGENTP_RADARR_URL=
HOMEAGENTP_QBITTORRENT_URL=
HOMEAGENTP_HOME_ASSISTANT_URL=
HOMEAGENTP_TELEGRAM_BOT_TOKEN=
